# ENV=dev allows the built-in dev secrets when JWT_SECRET / CRON_SECRET are unset.
# Anything else (or unset) = production: both secrets are REQUIRED and must be >= 32 chars,
# or the app refuses to start. Never set ENV=dev on Vercel.
ENV=dev

# Neon: paste the *pooled* connection string. postgresql:// is rewritten to use psycopg 3.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: separate database for pytest (wiped and rebuilt on every test run!).
TEST_DATABASE_URL=

# Dev values below are public; for production generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-000000
CRON_SECRET=dev-only-cron-secret-do-not-use-in-production-00000

# Base URL of the frontend, used for the absolute link in customer emails ({PUBLIC_BASE_URL}/t/{token}).
# Optional on Vercel (falls back to https://$VERCEL_PROJECT_PRODUCTION_URL) and with ENV=dev
# (falls back to http://localhost:5173). Required anywhere else.
PUBLIC_BASE_URL=
